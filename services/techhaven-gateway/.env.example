# ===== TechHaven Agent Gateway（TH-RFC-001 §05.1）=====

# Bearer 令牌：除 /healthz 外所有 API 都要求 `Authorization: Bearer <该值>`（必填，缺失拒绝启动）
# 生产级要求：≥32 字符随机值，生成示例 —— openssl rand -base64 36 或 node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# 仅由 BFF/开发代理持有并注入 X-TechHaven-Actor；浏览器不得接触该令牌
TECHHAVEN_GATEWAY_TOKEN=

# HTTP 监听端口（默认 3091）
TECHHAVEN_GATEWAY_PORT=3091

# HTTP 监听地址（默认 127.0.0.1）
# 默认只监听回环：3091 承载 Bearer 鉴权的 Agent API，只应被同机 Nginx/BFF 访问。
# 仅当 Gateway 独立部署在容器或另一台主机、需要跨机访问时，才显式改为 0.0.0.0 并用防火墙/安全组收紧来源。
TECHHAVEN_GATEWAY_HOST=127.0.0.1

# 引擎驱动：mock=脚本化闭环（演示/测试用）；dsh=真实 DeepSeek Harness 引擎（驱动文件另行交付，未就绪时启动即退出）
TECHHAVEN_ENGINE_DRIVER=mock

# 会话事件 / 审计 JSONL 目录（postgres 模式下是提交后 spool；文件名固定 gateway.jsonl）
TECHHAVEN_GATEWAY_DATA_DIR=./data

# JSONL 模式下与 techhaven-mcp ProposalStore 共用的 proposal 权威日志；Gateway 只提供查询/决策入口，不执行域写
TECHHAVEN_PROPOSALS_FILE=../techhaven-mcp/audit/proposals.jsonl

# 权威存储：jsonl（默认，单实例 PoC）| postgres（PG 权威，JSONL 只作 spool）
TECHHAVEN_GATEWAY_STORE=jsonl

# store=postgres 时必填；连接或事务失败会 fail-closed，不回退为 JSONL 权威
TECHHAVEN_GATEWAY_DB_URL=
TECHHAVEN_GATEWAY_DB_SCHEMA=public

# 单组织活动会话数配额（queued / running / awaiting_permission 计入；正整数）
TECHHAVEN_MAX_SESSIONS_PER_ORG=3

# 终态会话保留分钟数（0 = 不淘汰）
TECHHAVEN_SESSION_RETENTION_MINUTES=30

# 活动态会话空闲超时分钟数（0 = 关闭）
TECHHAVEN_SESSION_IDLE_TIMEOUT_MINUTES=30

# ===== 迁移/装载兼容变量 =====
# PostgreSQL 连接串：`npm run load` 把 gateway.jsonl 装载进 agent_identities / agent_sessions /
# agent_events 时使用（也可用 --url 参数传入，优先级更高）
# 示例：postgres://postgres:postgres@127.0.0.1:5432/techhaven
TECHHAVEN_DB_URL=

# ===== dsh 驱动 =====
# dsh 可执行文件路径（TECHHAVEN_DSH_BIN）
TECHHAVEN_DSH_BIN=
# dsh 引擎 profile 名（由 Gateway 统一下发，前端不可指定）
TECHHAVEN_DSH_PROFILE=
# dsh 主目录（引擎工作区 / 缓存根）
TECHHAVEN_DSH_HOME=

# 模型供应商变量由 Gateway 原样继承给 dsh；具体名称以 profile 为准
#DEEPSEEK_API_KEY=
#DEEPSEEK_BASE_URL=

# ===== 按用户解析 AI 配置（可选；两项必须同时设置）=====
# 产品后端/BFF 提供的内部只读端点。Gateway 会附加 ?user_id=<可信用户ID>，只接受 HTTPS（本机 HTTP 除外）。
# 响应 data：{ type: openai|claude|glm, provider?, response_type?, url, api_key(必须为明文), model?, reasoning_effort?, max_tokens? }
#   provider：openai|anthropic|zhipu|custom；缺省时从 type 推断
#   response_type：responses|chat_completions|messages；缺省时兼容旧记录（claude=messages，其余=chat_completions）
#   reasoning_effort：可选，dsh 推理档位（1~64 可见 ASCII，如 minimal/low/medium/high/max），缺省用模型默认
# 该端点只允许 Gateway 服务身份访问；浏览器不得调用，也不得返回脱敏 key 给 Gateway。
# 注意：设置下方 AI 配置主密钥后优先走 Agent DB 配置资产，本组变量成为降级链路。
TECHHAVEN_AI_CONFIG_URL=
TECHHAVEN_AI_CONFIG_SERVICE_TOKEN=
TECHHAVEN_AI_CONFIG_TIMEOUT_MS=5000

# ===== AI 配置资产（Agent DB v0.4，推荐）=====
# 一账号多套配置 / 组织共享 + 个人优先 / 用量与配额。需要 TECHHAVEN_GATEWAY_STORE=postgres。
# 主密钥：base64 编码的 32 字节，用于 AES-256-GCM 加密用户密钥。只存在服务器环境文件，不入库、不进 Git。
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TECHHAVEN_AI_CONFIG_MASTER_KEY=
# 主密钥版本号（默认 1）。轮换时：新主密钥填 MASTER_KEY + 版本号加一 + 旧主密钥填 PREVIOUS，
# 待存量密文全部重加密（重新保存密钥）后移除 PREVIOUS。
TECHHAVEN_AI_CONFIG_MASTER_KEY_VERSION=1
TECHHAVEN_AI_CONFIG_MASTER_KEY_PREVIOUS=

# 保存类型到 dsh profile 内 provider route 的映射。profile 必须用对应环境变量读取凭据和 base URL：
# openai -> OPENAI_API_KEY / OPENAI_BASE_URL
# claude -> ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL
# glm -> ZHIPUAI_API_KEY / ZHIPUAI_BASE_URL
TECHHAVEN_DSH_PROVIDER_OPENAI=openai
TECHHAVEN_DSH_PROVIDER_CLAUDE=anthropic
TECHHAVEN_DSH_PROVIDER_GLM=glm
