# ===== Agent Bridge 自身 =====
# 仅 MCP → Bridge 使用的内部 Bearer；必须是长随机值，不得进入浏览器或日志
TECHHAVEN_BRIDGE_TOKEN=
TECHHAVEN_BRIDGE_PORT=3093

# 单实例 append-only 幂等台账；服务器上应放持久卷并备份
TECHHAVEN_BRIDGE_LEDGER_FILE=./data/bridge-operations.jsonl

# ===== 旧后端 =====
# 包含 /api/v1，但不包含 /rd；例如 https://techhaven.website/api/v1
TECHHAVEN_LEGACY_BASE_URL=https://techhaven.website/api/v1
TECHHAVEN_LEGACY_RD_PREFIX=/rd
TECHHAVEN_LEGACY_TIMEOUT_MS=5000

# bearer：Authorization: Bearer <value>
# cookie：Cookie: <value>
# none：不附加旧后端凭据（仅允许受控内网测试）
TECHHAVEN_LEGACY_AUTH_MODE=bearer
TECHHAVEN_LEGACY_AUTH_VALUE=

# 可选：旧状态值 → Agent canonical 状态；未配置时按字符串原样透传。
# JSON 必须保持单行。Bridge 会自动反转映射后再向旧后端写入。
#TECHHAVEN_LEGACY_STATUS_MAP_JSON={"bug":{"0":"new","1":"accepted","2":"processing","3":"verified","4":"closed"},"requirement":{"0":"new","1":"developing","2":"testing","3":"done","4":"closed"},"task":{"0":"todo","1":"doing","2":"done"}}
