# ===== techhaven-mcp 配置 =====

# agent token（用 `npm run token -- issue ...` 签发，粘贴到这里）
# stdio 模式下也可由调用方（如 dsh）通过 env 注入，见 README
TECHHAVEN_AGENT_TOKEN=

# 审计/Agent 身份显示名
TECHHAVEN_AGENT_NAME=techhaven-mcp-poc

# token 签发/校验密钥（HMAC）。演示环境随便设一个长随机串即可；
# 正式环境必须与签发方（P1 为 Agent Gateway）共享且保密
TECHHAVEN_TOKEN_SECRET=dev-only-secret-change-me

# 后端模式：mock（离线演示数据）| http（MCP 直连旧后端）| bridge（推荐：经独立兼容层）
TECHHAVEN_BACKEND=mock

# http 模式：后端基地址与服务凭据（服务端到服务端，不把 agent token 传给后端）
TECHHAVEN_API_BASE_URL=https://techhaven.website/api/v1
TECHHAVEN_SERVICE_TOKEN=
TECHHAVEN_API_TIMEOUT_MS=5000

# bridge 模式：独立兼容层地址和 MCP → Bridge 内部 Bearer
# Token 必须与 services/techhaven-agent-bridge 的 TECHHAVEN_BRIDGE_TOKEN 一致
TECHHAVEN_BRIDGE_URL=http://127.0.0.1:3093
TECHHAVEN_BRIDGE_TOKEN=

# 审计日志（JSONL，append-only）
TECHHAVEN_AUDIT_FILE=./audit/agent-audit.jsonl

# 写模式：direct（默认）= update_ticket_status 直接生效；
#        staged = 写操作先存为提案（pending，带过期时间），变更不直接生效；
#        人工 `npm run proposal -- approve <id>` 批准后，server worker 主动应用
TECHHAVEN_WRITE_MODE=direct

# staged 模式分级审批：仍走提案审批的写工具清单（逗号分隔的工具名）；
# 未列入清单的写工具即使 staged 模式也直写（只读工具一律免审）；显式设为空 = staged 下全部直写
TECHHAVEN_WRITE_STAGED_TOOLS=update_ticket_status

# staged 模式：写提案事件存储（JSONL，append-only；含 created/approved/rejected/applied/expired）
TECHHAVEN_PROPOSALS_FILE=./audit/proposals.jsonl

# staged 模式：提案未决时限（分钟，正整数）；超时未批准自动过期 = 默认拒绝（安全侧倾斜）
TECHHAVEN_PROPOSAL_TTL_MINUTES=30

# ===== Agent 数据平面 =====
# mirror（默认）：JSONL proposal 权威，PG 可选镜像；连接失败兼容降级。
# authoritative：agent_write_proposals 是唯一权威，必须同时 WRITE_MODE=staged；连接/事务失败拒绝启动或写入。
TECHHAVEN_DB_MODE=mirror

# PostgreSQL 连接串（建表 DDL 见 docs/agent-db/schema.sql）。authoritative 模式必填。
# 配置后同一次会话内三者共用一个连接池：
#   1. 审计双写 agent_tool_calls（当前仍为 JSONL 主、PG 镜像）；
#   2. proposal 依 DB_MODE 选择镜像或 PG 权威 repository；
#   3. 语义层改读 semantic_* 表（数据需人工策展，查无时 get_semantics 返回 notFound）
#TECHHAVEN_DB_URL=

# 人工审批 CLI 在 PG 模式下还需组织 ID；批准人 ID 可选
#TECHHAVEN_APPROVAL_ORG_ID=1
#TECHHAVEN_APPROVER_ID=1
